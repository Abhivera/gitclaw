{
  "name": "gitclaw-desktop",
  "version": "0.1.1",
  "private": true,
  "description": "GitClaw desktop app — self-hosted AI PR reviewer",
  "author": "GitClaw contributors",
  "homepage": "https://github.com/Abhivera/gitclaw",
  "repository": {
    "type": "git",
    "url": "https://github.com/Abhivera/gitclaw.git"
  },
  "main": "main.mjs",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "icons": "node scripts/prepare-icons.mjs",
    "dist": "npm run icons && electron-builder --config electron-builder.config.cjs --publish never",
    "dist:win": "npm run icons && electron-builder --config electron-builder.config.cjs --win --publish never",
    "dist:mac": "npm run icons && electron-builder --config electron-builder.config.cjs --mac --publish never",
    "dist:linux": "npm run icons && electron-builder --config electron-builder.config.cjs --linux --publish never",
    "dist:dir": "npm run icons && electron-builder --config electron-builder.config.cjs --dir --publish never"
  },
  "dependencies": {
    "embedded-postgres": "17.10.0-beta.17",
    "ignore": "^7.0.14"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.gitclaw.app",
    "productName": "GitClaw",
    "copyright": "Copyright © GitClaw contributors",
    "icon": "icons/icon.png",
    "directories": {
      "output": "../release/desktop"
    },
    "files": [
      "main.mjs",
      "preload.cjs",
      "server.mjs",
      "env.mjs",
      "env-file.mjs",
      "first-run.mjs",
      "paths.mjs",
      "routes.mjs",
      "security.mjs",
      "local-files.mjs",
      "splash.html",
      "splash-mark.png",
      "package.json",
      "icons/**"
    ],
    "extraResources": [
      {
        "from": "../.next/standalone",
        "to": "standalone",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../.next/standalone/node_modules",
        "to": "standalone/node_modules",
        "filter": ["**/*"]
      },
      {
        "from": "icons/icon.ico",
        "to": "app-icon.ico"
      },
      {
        "from": "icons/icon.png",
        "to": "app-icon.png"
      }
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icons/icon.ico",
      "signAndEditExecutable": false,
      "artifactName": "GitClaw-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "GitClaw-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "icons/icon.png",
      "category": "public.app-category.developer-tools",
      "artifactName": "GitClaw-${version}-${arch}.${ext}",
      "identity": null,
      "gatekeeperAssess": false,
      "hardenedRuntime": false
    },
    "dmg": {
      "artifactName": "GitClaw-${version}-${arch}.${ext}"
    },
    "linux": {
      "executableName": "gitclaw",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icons/icon.png",
      "category": "Development",
      "artifactName": "GitClaw-${version}-${arch}.${ext}",
      "maintainer": "GitClaw contributors",
      "synopsis": "Self-hosted AI PR reviewer",
      "description": "GitClaw desktop app with embedded PostgreSQL — no Docker required."
    }
  }
}
