# --- Web / Docker (default) ---
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5438/gitclaw

# --- Desktop app (managed automatically; do not change ports) ---
# APP_URL=http://127.0.0.1:13100
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:15432/gitclaw
# Edit the desktop .env via File → Open configuration folder after install.

GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_SLUG=

GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GITLAB_BASE_URL=

BITBUCKET_CLIENT_ID=
BITBUCKET_CLIENT_SECRET=

AI_PROVIDER=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OPENAI_BASE_URL=
OPENAI_API_KEY=
GITCLAW_REVIEW_MODEL=

# Comma-separated tunnel hostname for desktop/webhook testing (e.g. abc.trycloudflare.com)
ALLOWED_DEV_ORIGINS=

# Optional: base URL for desktop installer files (default: {APP_URL}/downloads)
# Use a CDN or object storage URL if binaries are hosted outside the app image.
# DOWNLOAD_BASE_URL=https://gitclaw.online/downloads
